target/
*.log
.env

# Local toolchain and scratch-script directory: ignore the whole directory, but keep the
# Helm render validator that CI needs.
.tooling/*
!.tooling/helm-validate.py

# cargo vendor output (generated by `cargo vendor --respect-source-config cargo-vendor`,
# about 300 MB, not committed; the directory is named cargo-vendor so the Docker build
# context uses a fresh path and cannot serve stale vendor files from a Windows file share)
cargo-vendor/
cargo-vendor2/

# Local development output and scratch drafts
.dev/
.spill/
/tmp/
/lattice/
__pycache__/
web/install.log
web/*.tsbuildinfo

# IDE project files
.idea/
.vscode/

# Internal design documents and development-only harnesses are not part of this
# repository; keep them out of the submission even when the local checkout has them.
/Lattice-设计方案.md
/Lattice-架构图.mermaid
/client/
/platform/
/perf/
/scripts/

# syntax=docker/dockerfile:1
# Frontend image: built with node:22-alpine (npm via npmmirror, verified reachable from containers) → served by nginx:latest
FROM node:22-alpine AS builder

WORKDIR /app

RUN npm config set registry https://registry.npmmirror.com

COPY web/package.json ./
RUN npm install --no-audit --no-fund

COPY web/ ./
RUN npm run build

# ---------------------------------------------------------------- runtime
FROM nginx:latest AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/conf.d/lattice.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
STOPSIGNAL SIGQUIT

# nginx:latest ships no wget (verified), only curl / bash. /dev/tcp also works but curl is clearer.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD curl -fsS -o /dev/null http://127.0.0.1/ || exit 1

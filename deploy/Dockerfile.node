# Backend image: the build stage uses local node:22-bookworm (bundles curl/git/gcc/make) to install Rust;
# all dependencies come from cargo vendor (host cargo-vendor/ dir, generated by cargo vendor --respect-source-config cargo-vendor), and the build never reaches crates.io.
FROM node:22-bookworm AS builder

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_TERM_COLOR=never \
    CARGO_NET_OFFLINE=true

# Measured: DNS inside the container cannot resolve rsproxy.cn; static.rust-lang.org is reachable but downloads stall;
# the Tsinghua tuna mirror delivers 21MB/2.4s, so both rustup and the toolchain go through tuna.
ENV RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup \
    RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup

RUN curl -sSfL -o /tmp/rustup-init \
      https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup/dist/x86_64-unknown-linux-gnu/rustup-init \
 && chmod +x /tmp/rustup-init \
 && /tmp/rustup-init -y --profile minimal --default-toolchain stable --no-modify-path \
 && rm -f /tmp/rustup-init \
 && rustc --version && cargo --version

WORKDIR /src

COPY deploy/cargo-vendor.toml /usr/local/cargo/config.toml
COPY cargo-vendor2 ./vendor
COPY Cargo.toml Cargo.lock ./
COPY proto ./proto
COPY crates ./crates

# Use a cache mount for target: compiled crates survive an interrupted build and are reused next time.
# Image builds skip LTO (the host release profile sets lto="thin", which notably lengthens the build).
# `--bins` builds both lattice-node and lattice-transfer: the download data plane ships in the
# same image and a Deployment/Compose service selects it with `entrypoint`/`command`.
RUN --mount=type=cache,target=/src/target,sharing=locked \
    CARGO_PROFILE_RELEASE_LTO=false \
    cargo build --release --locked --offline -p lattice-node --bins --features quic,wasm-host,webtransport \
 && cp target/release/lattice-node /src/lattice-node.bin \
 && cp target/release/lattice-transfer /src/lattice-transfer.bin \
 && ls -lh /src/lattice-node.bin /src/lattice-transfer.bin

# ---------------------------------------------------------------- runtime
FROM debian:bookworm-slim AS runtime

RUN groupadd --gid 10001 lattice \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin lattice

COPY --from=builder /src/lattice-node.bin /usr/local/bin/lattice-node
COPY --from=builder /src/lattice-transfer.bin /usr/local/bin/lattice-transfer
COPY deploy/config/dev.toml /etc/lattice/config.toml

RUN chmod +x /usr/local/bin/lattice-node /usr/local/bin/lattice-transfer \
 && mkdir -p /etc/lattice/keys && chown -R 10001:10001 /etc/lattice

USER 10001
WORKDIR /etc/lattice
# 8080 node HTTP, 9090 node gRPC, 8090 transfer data plane, 9101 transfer metrics, 4433/udp QUIC
EXPOSE 8080 9090 8090 9101 4433/udp
STOPSIGNAL SIGTERM

# The runtime image has no curl, so probe HTTP with bash's /dev/tcp
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=5 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /v1/ready HTTP/1.0\r\n\r\n" >&3 && cat <&3 | grep -q "ready"'

ENTRYPOINT ["/usr/local/bin/lattice-node"]
CMD ["--config", "/etc/lattice/config.toml"]

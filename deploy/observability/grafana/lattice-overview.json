    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Metric: lattice_store_latency_seconds (histogram, seconds). ⚠ registered in metrics.rs, but record_store() has no call site yet (PG/Redis/S3 access is not instrumented) → this panel shows No data until then, and the alert is on standby as well.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
